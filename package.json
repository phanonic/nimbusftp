{
  "name": "nimbusftp",
  "version": "1.0.0",
  "description": "Nimbus FTP - modern FTP/FTPS/SFTP client",
  "main": "src/main.js",
  "author": "Nimbus",
  "license": "MIT",
  "build": {
    "appId": "app.nimbusftp",
    "productName": "NimbusFTP",
    "files": ["src/**/*", "package.json"],
    "win": { "target": [{"target":"portable","arch":["x64"]}], "signAndEditExecutable": false },
    "portable": { "artifactName": "NimbusFTP-${version}-portable.exe" },
    "directories": { "output": "dist" }
  },
  "dependencies": { "basic-ftp": "*", "ssh2-sftp-client": "*" },
  "devDependencies": { "electron": "*", "electron-builder": "*" }
}
