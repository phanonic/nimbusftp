{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NimbusFTP",
  "version": "2.0.10",
  "identifier": "app.nimbusftp",
  "build": {
    "frontendDist": "../dist-ui",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NimbusFTP",
        "width": 1360,
        "height": 840,
        "minWidth": 1020,
        "minHeight": 620,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
